# =============================================================================
# Edge Telemetry Agent — Containerfile
# Multi-stage build: Go build → minimal Alpine runtime
#
# Stage 1 (builder): compiles the static binary
# Stage 2 (runtime): scratch-like Alpine image, ~10 MB total
#
# Build:
#   podman build -t edge-agent:latest .
#
# Run (standalone):
#   podman run --rm \
#     -e DEVICE_ID=dev1 \
#     -e BACKEND_ADDR=host.containers.internal:50051 \
#     edge-agent:latest
#
# Note on /proc in containers:
#   The agent reads /proc/stat, /proc/meminfo, /proc/net/dev.
#   In a container, /proc is the container's own proc namespace — it reports
#   CPU/memory usage for the container's cgroup, not the host. This is the
#   correct behaviour for containerised edge agents: each container instance
#   represents an independent "device" with its own resource view.
#
#   To report host-level metrics instead (e.g. for a monitoring sidecar):
#     podman run --pid=host -v /proc:/proc:ro edge-agent:latest
# =============================================================================

FROM golang:1.21-alpine AS builder

RUN apk add --no-cache git

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -ldflags="-s -w" \
      -o /agent \
      cmd/agent/main.go

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

RUN addgroup -S agent && adduser -S agent -G agent
USER agent

WORKDIR /home/agent

COPY --from=builder /agent ./agent

ENV DEVICE_ID=unknown
ENV BACKEND_ADDR=localhost:50051
ENV SAMPLING_INTERVAL=5s

ENTRYPOINT ["./agent"]
